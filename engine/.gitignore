# Cargo build output
/target/

# Built Node-API addons. The engine sources under native/core and native/node
# are tracked; the per-target directories the build writes alongside them hold
# the compiled git-graph.node binaries and are build artefacts, never commits.
native/*/
!native/core/
!native/node/

# The pinned zig `build-all.mjs` installs. Outside target/ so a cache action
# can own that directory without evicting this.
/.toolchain/
