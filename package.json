{
  "name": "git-graph-libre",
  "displayName": "%displayName%",
  "version": "1.3.0",
  "description": "%description%",
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "action",
    "branch",
    "cherry-pick",
    "commit",
    "devcontainer",
    "diff",
    "git",
    "git graph",
    "git graph libre",
    "git history",
    "git log",
    "github",
    "graph",
    "merge",
    "push",
    "repository",
    "revert",
    "scm",
    "stash",
    "tag",
    "version control",
    "visualize"
  ],
  "homepage": "https://github.com/PlohnenSoftware/git-graph-libre",
  "bugs": {
    "url": "https://github.com/PlohnenSoftware/git-graph-libre/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Zamkorus (PlohnenSoftware)"
  },
  "contributors": [
    {
      "name": "Michael Hutchison",
      "url": "https://github.com/mhutchie"
    },
    {
      "name": "Asis Pattisahusiwa",
      "url": "https://github.com/asispts"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PlohnenSoftware/git-graph-libre.git"
  },
  "publisher": "PlohnenSoftware",
  "main": "./out/extension.js",
  "scripts": {
    "typecheck": "tsc -p ./src --noEmit && tsc -p ./src/webview --noEmit && tsc -p ./tests --noEmit",
    "vscode:prepublish": "pnpm run clean && pnpm run package",
    "package": "pnpm run typecheck && pnpm run lint && node esbuild.js --production",
    "clean": "node -e \"const {rmSync}=require('fs');for(const d of ['out','tests/out'])rmSync(d,{recursive:true,force:true})\"",
    "compile": "pnpm run clean && node esbuild.js",
    "test": "vitest run --project backend && vitest run --project webview",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:ext": "pnpm run compile && pnpm run compile-tests && vscode-test",
    "compile-tests": "tsc -p tests/extension/tsconfig.json && tsc-alias -p tests/extension/tsconfig.json",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -p ./src --noEmit --watch",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "format:changed": "biome format --changed --no-errors-on-unmatched .",
    "format:changed:fix": "biome format --write --changed --no-errors-on-unmatched .",
    "format:staged": "biome format --staged --no-errors-on-unmatched .",
    "format:staged:fix": "biome format --write --staged --no-errors-on-unmatched .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:changed": "biome lint --changed --no-errors-on-unmatched .",
    "lint:staged": "biome lint --staged --no-errors-on-unmatched .",
    "lint:strict:changed": "biome lint --config-path biome.strict.jsonc --changed --no-errors-on-unmatched --error-on-warnings .",
    "lint:strict:staged": "biome lint --config-path biome.strict.jsonc --staged --no-errors-on-unmatched --error-on-warnings .",
    "sonar:auth": "sonar auth login -s http://127.0.0.1:9000",
    "sonar:auth:status": "sonar auth status",
    "sonar:scan": "sonar-scanner",
    "sonar:scan:local": "sonar-scanner -Dsonar.host.url=http://127.0.0.1:9000",
    "sonar:secrets": "sonar analyze secrets .",
    "l10n:check": "node ./scripts/check-l10n.js",
    "icons:generate": "node ./scripts/generate-octicons.js && biome format --write src/octicons.ts"
  },
  "dependencies": {
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@primer/octicons": "^19.31.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "~1.98.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.view",
        "title": "%command.view%",
        "icon": {
          "light": "resources/webview-icon-grey-light.svg",
          "dark": "resources/webview-icon-grey-dark.svg"
        }
      },
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.clearAvatarCache",
        "title": "%command.clearAvatarCache%"
      },
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.searchCommits",
        "title": "%command.searchCommits%"
      },
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.viewActiveEditorRepo",
        "title": "%command.viewActiveEditorRepo%"
      },
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.addRepo",
        "title": "%command.addRepo%"
      },
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.removeRepo",
        "title": "%command.removeRepo%"
      },
      {
        "category": "Git Graph Libre",
        "command": "git-graph-libre.showDiagnostics",
        "title": "%command.showDiagnostics%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "git-graph-libre.view",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "git-graph-libre.autoCenterCommitDetailsView": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoCenterCommitDetailsView%"
        },
        "git-graph-libre.commitDetails.fileViewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "enumDescriptions": [
            "%config.commitDetails.fileViewMode.tree%",
            "%config.commitDetails.fileViewMode.list%"
          ],
          "default": "tree",
          "description": "%config.commitDetails.fileViewMode%"
        },
        "git-graph-libre.commitDetails.compactFolders": {
          "type": "boolean",
          "default": false,
          "description": "%config.commitDetails.compactFolders%"
        },
        "git-graph-libre.dateFormat": {
          "type": "string",
          "enum": [
            "Date & Time",
            "Date Only",
            "Relative"
          ],
          "enumDescriptions": [
            "%config.dateFormat.dateTime%",
            "%config.dateFormat.dateOnly%",
            "%config.dateFormat.relative%"
          ],
          "default": "Date & Time",
          "description": "%config.dateFormat%"
        },
        "git-graph-libre.dateType": {
          "type": "string",
          "enum": [
            "Author Date",
            "Commit Date"
          ],
          "enumDescriptions": [
            "%config.dateType.authorDate%",
            "%config.dateType.commitDate%"
          ],
          "default": "Author Date",
          "description": "%config.dateType%"
        },
        "git-graph-libre.columns.signature": {
          "type": "boolean",
          "default": false,
          "description": "%config.columns.signature%"
        },
        "git-graph-libre.fetchAvatars": {
          "type": "boolean",
          "default": false,
          "description": "%config.fetchAvatars%"
        },
        "git-graph-libre.customBranchGlobPatterns": {
          "type": "array",
          "default": [],
          "description": "%config.customBranchGlobPatterns%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "glob"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "%config.customBranchGlobPatterns.name%"
              },
              "glob": {
                "type": "string",
                "description": "%config.customBranchGlobPatterns.glob%"
              }
            }
          }
        },
        "git-graph-libre.contextMenuActionsVisibility": {
          "type": "object",
          "default": {},
          "description": "%config.contextMenuActionsVisibility%",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "commit": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "commitDetailsViewFile": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "remoteBranch": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "stash": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "tag": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            },
            "uncommittedChanges": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        },
        "git-graph-libre.repository.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "description": "%config.repository.showRemoteBranches%"
        },
        "git-graph-libre.repository.showStashes": {
          "type": "boolean",
          "default": true,
          "description": "%config.repository.showStashes%"
        },
        "git-graph-libre.repository.showTags": {
          "type": "boolean",
          "default": true,
          "description": "%config.repository.showTags%"
        },
        "git-graph-libre.repository.includeReflog": {
          "type": "boolean",
          "default": false,
          "description": "%config.repository.includeReflog%"
        },
        "git-graph-libre.repository.includeUnreachableCommits": {
          "type": "boolean",
          "default": false,
          "description": "%config.repository.includeUnreachableCommits%"
        },
        "git-graph-libre.repository.onlyFollowFirstParent": {
          "type": "boolean",
          "default": false,
          "description": "%config.repository.onlyFollowFirstParent%"
        },
        "git-graph-libre.repository.muteCommitsNotAncestorsOfHead": {
          "type": "boolean",
          "default": false,
          "description": "%config.repository.muteCommitsNotAncestorsOfHead%"
        },
        "git-graph-libre.repository.muteMergeCommits": {
          "type": "boolean",
          "default": false,
          "description": "%config.repository.muteMergeCommits%"
        },
        "git-graph-libre.repository.boldCheckedOutCommit": {
          "type": "boolean",
          "default": false,
          "description": "%config.repository.boldCheckedOutCommit%"
        },
        "git-graph-libre.repository.fetchTagsByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%config.repository.fetchTagsByDefault%"
        },
        "git-graph-libre.graphColors": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Color (OKLCH, HEX, or RGB)",
            "pattern": "^\\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgb[a]?\\s*\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\)|oklch\\(\\s*\\d{1,3}(\\.\\d+)?%\\s+\\d(\\.\\d+)?\\s+\\d{1,3}(\\.\\d+)?(\\s*/\\s*(0(\\.\\d+)?|1))?\\s*\\))\\s*$"
          },
          "default": [
            "oklch(59% 0.21 245)",
            "oklch(59% 0.21 350)",
            "oklch(59% 0.21 145)",
            "oklch(59% 0.21 70)",
            "oklch(59% 0.21 305)",
            "oklch(59% 0.21 27)",
            "oklch(59% 0.21 190)",
            "oklch(59% 0.21 325)",
            "oklch(59% 0.21 130)",
            "oklch(59% 0.21 45)",
            "oklch(59% 0.21 295)",
            "oklch(59% 0.21 95)"
          ],
          "description": "%config.graphColors%"
        },
        "git-graph-libre.revealHighlightColor": {
          "type": "string",
          "default": "oklch(90% 0.25 150 / 0.42)",
          "pattern": "^\\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgb[a]?\\s*\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\)|oklch\\(\\s*\\d{1,3}(\\.\\d+)?%\\s+\\d(\\.\\d+)?\\s+\\d{1,3}(\\.\\d+)?(\\s*/\\s*(0(\\.\\d+)?|1))?\\s*\\))\\s*$",
          "description": "%config.revealHighlightColor%"
        },
        "git-graph-libre.graphStyle": {
          "type": "string",
          "enum": [
            "rounded",
            "angular"
          ],
          "enumDescriptions": [
            "%config.graphStyle.rounded%",
            "%config.graphStyle.angular%"
          ],
          "default": "rounded",
          "description": "%config.graphStyle%"
        },
        "git-graph-libre.graph.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 24,
          "description": "%config.graph.fontSize%"
        },
        "git-graph-libre.graph.rowHeight": {
          "type": "number",
          "default": 24,
          "minimum": 18,
          "maximum": 48,
          "description": "%config.graph.rowHeight%"
        },
        "git-graph-libre.shortHashLength": {
          "type": "number",
          "default": 8,
          "minimum": 4,
          "maximum": 64,
          "description": "%config.shortHashLength%"
        },
        "git-graph-libre.initialLoadCommits": {
          "type": "number",
          "default": 300,
          "description": "%config.initialLoadCommits%"
        },
        "git-graph-libre.loadMoreCommits": {
          "type": "number",
          "default": 100,
          "description": "%config.loadMoreCommits%"
        },
        "git-graph-libre.maxDepthOfRepoSearch": {
          "type": "number",
          "default": 0,
          "description": "%config.maxDepthOfRepoSearch%"
        },
        "git-graph-libre.showCurrentBranchByDefault": {
          "type": "boolean",
          "default": false,
          "description": "%config.showCurrentBranchByDefault%"
        },
        "git-graph-libre.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBarItem%"
        },
        "git-graph-libre.showUncommittedChanges": {
          "type": "boolean",
          "default": true,
          "description": "%config.showUncommittedChanges%"
        },
        "git-graph-libre.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.telemetry.enabled%",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        },
        "git-graph-libre.tabIconColorTheme": {
          "type": "string",
          "enum": [
            "color",
            "grey"
          ],
          "enumDescriptions": [
            "%config.tabIconColorTheme.color%",
            "%config.tabIconColorTheme.grey%"
          ],
          "default": "color",
          "description": "%config.tabIconColorTheme%"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "packageManager": "pnpm@10.33.0"
}
